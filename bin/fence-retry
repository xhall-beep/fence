#!/usr/bin/env bash
# fence-retry - capped retry policy for a fenced service.
#
# WHY: a guardian restarting a fenced service every ~2 minutes for hours is an
# outage with extra steps. A repeating restart IS the incident - escalate the
# pattern, do not amplify it. Ten 60 s retries ride out a probe blip; beyond
# that the service backs off to 15 minutes and says so once per episode.
#
# Kept as its own script so the policy can be tested with zero service
# interaction: FENCE_RETRY_S=0 FENCE_BACKOFF_S=0 FENCE_STATE=<tmp>.
#
# Env: FENCE_RETRY_S=60  FENCE_BACKOFF_S=900  FENCE_RETRY_MAX=10  FENCE_STATE
# Usage: fence-retry [--reset]
set -u
STATE="${FENCE_STATE:-$HOME/.agent-ops/fence-retry-state}"
RETRY="${FENCE_RETRY_S:-60}"
BACKOFF="${FENCE_BACKOFF_S:-900}"
MAX="${FENCE_RETRY_MAX:-10}"

if [ "${1:-}" = "--reset" ]; then
  rm -f "$STATE"
  exit 0
fi

mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
n=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$STATE" 2>/dev/null || true

if [ "$n" -ge $((MAX + 1)) ]; then
  if [ "$n" -eq $((MAX + 1)) ]; then
    echo "fence-retry: ESCALATION ${n} consecutive fenced starts - backing off to ${BACKOFF}s (repeating restart is the incident, not the fix)"
  fi
  sleep "$BACKOFF"
else
  echo "fence-retry: FENCED by epoch (peer epoch higher than local) - not starting service (attempt ${n}/${MAX})"
  sleep "$RETRY"
fi
exit 1
